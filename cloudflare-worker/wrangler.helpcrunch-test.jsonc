{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auction-auto-helpcrunch-test",
  "main": "src/helpcrunch_test_entry.py",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "HC_DB",
      "database_name": "helpcrunch-test-memory",
      "database_id": "d726c736-2efa-4944-a98f-f6efe26a5c00",
      "migrations_dir": "migrations/helpcrunch"
    }
  ],
  "vars": {
    "HELPCRUNCH_PILOT_ENABLED": "true",
    "HELPCRUNCH_BRANDS_JSON": "{\"1\":\"Auction Auto\",\"3\":\"Atlantic Express\",\"4\":\"Atlantic Auto\",\"5\":\"Atlantic West\",\"6\":\"Atlantic Express\",\"7\":\"Atlantic Express\",\"8\":\"Atlantic Express\",\"9\":\"Auction Auto\",\"13\":\"AutoCanada\",\"15\":\"ID4\",\"16\":\"ID6\"}",
    "HELPCRUNCH_NIGHT_ENABLED": "true",
    "HELPCRUNCH_NIGHT_SEND_ENABLED": "false"
  }
}
